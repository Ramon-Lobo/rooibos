namespace rooibos
    ' @ignore
    function init(testSceneName = invalid as string) as void
        if createObject("roAPPInfo").IsDev() <> true then
            rooibos.common.logError(" not running in dev mode! - rooibos tests only support side-loaded builds - aborting")
            return
        end if

        screen = CreateObject("roSGScreen")
        m.port = CreateObject("roMessagePort")
        screen.setMessagePort(m.port)
        if testSceneName = invalid or testSceneName = "" then
            testSceneName = "RooibosScene"
        end if

        rooibos.common.logInfo(`Starting test using test scene with name RooibosScene ${testSceneName}`)
        scene = screen.CreateScene(testSceneName)
        scene.id = "ROOT"
        screen.show()

        m.global = screen.getGlobalNode()
        m.global.addFields({
            "testsScene": scene
            "_rbs_ccn": createObject("roSGNode", "CodeCoverage")
        })

        ' Seed test-scene fields from an optional pkg:/rooibos_global_seed.json (written by the test
        ' harness). A bare @SGNode widget's getGlobalField(...) reads scene.getField(...), so without
        ' the real app's globals those reads return invalid and the widget crashes on device while
        ' constructing. Seeding e.g. an empty config/user AA lets it construct like it would in-app.
        ' Runs before any test node is created. No file → no-op.
        rooibos.internal_seedGlobalFields(scene)

        if scene.hasField("isReadyToStartTests") and scene.isReadyToStartTests = false then
            rooibos.common.logInfo("The scene is not ready yet - waiting for it to set isReadyToStartTests to true")
            scene.observeField("isReadyToStartTests", m.port)

        else
            rooibos.common.logInfo("scene is ready; running tests now")
            print ""
            runner = new rooibos.TestRunner(scene, m)
            runner.Run()

            if runner.config.keepAppOpen = false then
                rooibos.common.logInfo("keepAppOpen is false; exiting Rooibos")
                ' End statement will also exit the caller of this function
                ' leading to an instant exit of the application

                ' Give the io port time to finish sending all the logs
                sleep(400)
                end
            end if
        end if

        while true
            msg = wait(0, m.port)
            msgType = type(msg)
            if msgType = "roSGScreenEvent" then
                if msg.isScreenClosed() then
                    return
                end if
            else if msgType = "roSGNodeEvent" then

                if msg.getField() = "isReadyToStartTests" and msg.getData() = true then
                    rooibos.common.logInfo("scene is ready; running tests now")
                    print ""
                    runner = new rooibos.TestRunner(scene, m)
                    runner.Run()
                end if
            end if
        end while
    end function

    ' @ignore
    ' Seeds fields on the test scene from pkg:/rooibos_global_seed.json (a JSON object of field ->
    ' value, written by the harness — e.g. roku-test's `globalFields` config). Lets @SGNode widgets
    ' that read global context via the scene (getGlobalField -> scene.getField) construct without
    ' hitting invalid on device. Safe no-op when the file is absent or malformed.
    function internal_seedGlobalFields(scene as object) as void
        raw = ReadAsciiFile("pkg:/rooibos_global_seed.json")
        if raw = invalid or raw = "" then
            return
        end if
        seed = ParseJson(raw)
        if type(seed) <> "roAssociativeArray" then
            return
        end if
        ' The seed is node-keyed: top-level keys are @SGNode type names, plus "*" for defaults applied
        ' to every suite. Values are { fieldName: value } maps. Stash it on the scene so runNodeTest
        ' can apply the right slice per node suite (see internal_applyGlobalFieldsForNode).
        scene.addFields({ "__rooibosGlobalSeed": seed })
        ' Apply the "*" defaults now for the initial scene state and any non-node (plain) suites.
        rooibos.internal_applyGlobalFieldsForNode(scene, invalid)
    end function

    ' @ignore
    ' Applies the global-field seed slice for a given @SGNode type to the test scene: the "*" defaults
    ' first (so each suite starts from the same baseline — declare a field as null there to reset it),
    ' then the per-node overrides. Call before creating each node suite so a bare widget's
    ' getGlobalField(x) (which reads scene.getField(x)) returns that suite's intended context instead
    ' of leaking the previous suite's. nodeName = invalid applies only the defaults.
    function internal_applyGlobalFieldsForNode(scene as object, nodeName as dynamic) as void
        seed = scene.getField("__rooibosGlobalSeed")
        if type(seed) <> "roAssociativeArray" then
            return
        end if
        rooibos.internal_applyFieldSet(scene, seed["*"])
        if nodeName <> invalid and type(seed[nodeName]) = "roAssociativeArray" then
            rooibos.internal_applyFieldSet(scene, seed[nodeName])
        end if
    end function

    ' @ignore
    ' Sets each { field: value } on the scene, creating the field (type inferred from the value) if it
    ' does not exist yet. A JSON null seeds the field as invalid (the way to opt a suite OUT of a
    ' default that another suite needs).
    function internal_applyFieldSet(scene as object, fields as dynamic) as void
        if type(fields) <> "roAssociativeArray" then
            return
        end if
        for each f in fields
            value = fields[f]
            if not scene.hasField(f) then
                fieldType = "assocarray"
                valueType = type(value)
                if valueType = "roString" or valueType = "String" then
                    fieldType = "string"
                else if valueType = "roBoolean" or valueType = "Boolean" then
                    fieldType = "boolean"
                else if valueType = "roArray" then
                    fieldType = "array"
                else if valueType = "roInt" or valueType = "Integer" or valueType = "roFloat" or valueType = "Float" or valueType = "Double" then
                    fieldType = "float"
                end if
                scene.addField(f, fieldType, false)
            end if
            scene.setField(f, value)
        end for
    end function

    ' @ignore
    function versionCompare(v1 as string, v2 as string) as integer
        v1parts = v1.split(".")
        v2parts = v2.split(".")

        while v1parts.count() < v2parts.count()
            v1parts.push("0")
        end while

        while v2parts.count() < v1parts.count()
            v2parts.push("0")
        end while

        for i = 0 to v1parts.count() - 1
            if v2parts.count() = i then
                return 1
            end if

            if v1parts[i] <> v2parts[i] then
                if v1parts[i] > v2parts[i] then
                    return 1
                else
                    return -1
                end if
            end if
        end for

        if v1parts.count() <> v2parts.count() then
            return -1
        end if

        return 0

    end function
end namespace
