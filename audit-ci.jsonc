{
    // Fail on high severity and above. See README "Accepted security advisories" for
    // why each allowlisted entry is safe to defer.
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    "high": true,
    // Empty on purpose. GHSA-w5hq-g745-h8pq (`uuid` <11.1.1, via `postman-request` and dev-only
    // `nyc>istanbul-lib-processinfo`) used to be listed here, but it is rated *moderate* and
    // `"high": true` never evaluates moderates — so the entry was inert and audit-ci printed
    // "Consider not allowlisting advisory: GHSA-w5hq-g745-h8pq" on every run. Its reasoning is kept
    // for the record: the vulnerable path is `v3()`/`v5()`/`v6()` with a caller-provided buffer, and
    // every consumer in this dep graph calls only `v4()` (no buffer arg), so it is unreachable.
    // If uuid is ever re-rated to high, that should surface as a fresh review, not a pre-approval.
    "allowlist": []
}
